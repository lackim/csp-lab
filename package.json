{
  "name": "csp-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "csp-lab": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run typecheck:test && node --test test/*.test.ts",
    "test:mcp": "npm run build && npm run typecheck:test && node test/mcp-smoke.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@shipcli/core": "0.5.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "25.4.0",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
